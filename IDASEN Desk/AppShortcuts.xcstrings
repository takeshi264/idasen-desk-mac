{
  "sourceLanguage": "en",
  "strings": {
    "Lower my desk with ${applicationName}": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${applicationName}でデスクを下げる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}降低桌子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用${applicationName}降低桌子"
          }
        }
      }
    },
