    "Work in any app. Press a shortcut again while the desk is moving to stop it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも使えます。移動中にもう一度押すと停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中都可用。桌子移动时再按一次可停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
