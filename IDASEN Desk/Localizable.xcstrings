    "Stand Up, Sit Down, Toggle Sit/Stand, Move Desk to Height and Get Desk Height are available in Shortcuts and Siri.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットと Siri で「立つ」「座る」「座る/立つを切り替え」「デスクを指定の高さへ移動」「デスクの高さを取得」が使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“快捷指令”和 Siri 中可以使用：站起来、坐下、切换坐站、将桌子移到指定高度、获取桌子高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「捷徑」和 Siri 中可以使用：站起來、坐下、切換坐站、將桌子移到指定高度、取得桌子高度。"
          }
        }
      }
    },
