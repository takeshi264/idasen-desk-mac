    "Turn on Bluetooth and the desk reconnects by itself.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth をオンにすると自動的に再接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开蓝牙后，桌子会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開藍牙後，桌子會自動重新連線。"
          }
        }
      }
    },
    "Two quick taps up go to standing height, two taps down go to sitting height.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上に 2 回すばやくタップすると立ち姿勢、下に 2 回で座り姿勢の高さへ移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上快速点两下升到站姿高度，向下点两下降到坐姿高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上快速點兩下升到站姿高度，向下點兩下降到坐姿高度。"
          }
        }
      }
    },
